#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        btcrl {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <46 47 48>;
        };
    };

    macros {
        toWin: toWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &bt BT_SEL 0>;
            label = "TOWIN";
        };

        toiPad: toiPad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &bt BT_SEL 1>;
            label = "TOIPAD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE  &kp Q         &kp W    &kp E     &kp R       &kp T  &kp Y      &kp U      &kp I      &kp O          &kp P             &kp BSPC
&kp TAB    &kp A         &kp S    &kp D     &kp F       &kp G  &kp H      &kp J      &kp K      &kp L          &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT  &kp Z         &kp X    &kp C     &kp V       &kp B  &kp SPACE  &kp SPACE  &kp N      &kp M          &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI  &kp ESC  &kp LALT  &kp DELETE  &mo 2  &mkp LCLK  &mkp RCLK  &kp MINUS  &kp RIGHT_ALT  &mo 3             &mo 2
            >;
        };

        layer_1 {
            bindings = <
&kp LC(SPACE)  &kp Q         &kp W    &kp E     &kp R       &kp T  &kp Y      &kp U      &kp I      &kp O          &kp P             &kp BSPC
&kp TAB        &kp A         &kp S    &kp D     &kp F       &kp G  &kp H      &kp J      &kp K      &kp L          &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT      &kp Z         &kp X    &kp C     &kp V       &kp B  &kp SPACE  &kp SPACE  &kp N      &kp M          &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL      &kp LEFT_GUI  &kp ESC  &kp LALT  &kp DELETE  &mo 2  &mkp LCLK  &mkp RCLK  &kp MINUS  &kp RIGHT_ALT  &mo 3             &mo 2
            >;
        };

        layer_2 {
            bindings = <
&trans     &none           &kp UP_ARROW  &none            &none             &none  &kp N1     &kp N2     &kp N3  &none   &none   &kp BSPC
&kp TAB    &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &none             &none  &kp N4     &kp N5     &kp N6  &none   &none   &kp ENTER
&kp LSHFT  &none           &none         &none            &none             &none  &kp SPACE  &kp SPACE  &kp N7  &kp N8  &kp N9  &none      &none  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI    &kp ESC       &kp LALT         &kp LEFT_COMMAND  &mo 2  &mkp LCLK  &mkp RCLK  &kp N0  &none   &mo 3   &mo 2
            >;
        };

        layer_3 {
            bindings = <
&trans          &toWin  &toiPad  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock
&bt BT_CLR_ALL  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &none   &mo 3   &trans
            >;
        };
    };
};
