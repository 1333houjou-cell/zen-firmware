#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <48 47 46>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE  &kp Q         &kp W    &kp E     &kp R             &kp T  &kp Y      &kp U      &kp I  &kp O  &kp P             &kp BSPC
&kp TAB    &kp A         &kp S    &kp D     &kp F             &kp G  &kp H      &kp J      &kp K  &kp L  &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT  &kp Z         &kp X    &kp C     &kp V             &kp B  &kp SPACE  &kp SPACE  &kp N  &kp M  &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI  &kp ESC  &kp LALT  &kp LEFT_COMMAND  &mo 0  &mkp LCLK  &mkp RCLK  &none  &to 0  &mo 4             &mo 3
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp Q         &kp W    &kp E     &kp R             &kp T  &kp Y      &kp U      &kp I  &kp O  &kp P             &kp BSPC
&kp TAB    &kp A         &kp S    &kp D     &kp F             &kp G  &kp H      &kp J      &kp K  &kp L  &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT  &kp Z         &kp X    &kp C     &kp V             &kp B  &kp SPACE  &kp SPACE  &kp N  &kp M  &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI  &kp ESC  &kp LALT  &kp LEFT_COMMAND  &mo 0  &mkp LCLK  &mkp RCLK  &none  &to 0  &mo 4             &mo 0
            >;
        };

        layer_2 {
            bindings = <
&kp GRAVE  &kp Q         &kp W    &kp E     &kp R             &kp T  &kp Y      &kp U      &kp I  &kp O  &kp P             &kp BSPC
&kp TAB    &kp A         &kp S    &kp D     &kp F             &kp G  &kp H      &kp J      &kp K  &kp L  &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT  &kp Z         &kp X    &kp C     &kp V             &kp B  &kp SPACE  &kp SPACE  &kp N  &kp M  &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI  &kp ESC  &kp LALT  &kp LEFT_COMMAND  &mo 0  &mkp LCLK  &mkp RCLK  &none  &to 0  &mo 4             &mo 0
            >;
        };

        layer_3 {
            bindings = <
&kp GRAVE  &kp Q         &kp W    &kp E     &kp R             &kp T  &kp Y      &kp U      &kp I  &kp O  &kp P             &kp BSPC
&kp TAB    &kp A         &kp S    &kp D     &kp F             &kp G  &kp H      &kp J      &kp K  &kp L  &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT  &kp Z         &kp X    &kp C     &kp V             &kp B  &kp SPACE  &kp SPACE  &kp N  &kp M  &kp COMMA         &kp DOT    &kp SEMICOLON  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_GUI  &kp ESC  &kp LALT  &kp LEFT_COMMAND  &mo 0  &mkp LCLK  &mkp RCLK  &none  &to 0  &mo 4             &mo 0
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
